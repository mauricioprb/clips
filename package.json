{
    "$schema": "https://www.schemastore.org/package.json",
    "private": true,
    "type": "module",
    "engines": {
        "node": "^24.0.0",
        "npm": ">=11.0.0"
    },
    "scripts": {
        "dev": "vite",
        "build": "vite build",
        "type-check": "vue-tsc --noEmit",
        "test": "vitest run",
        "lint": "eslint . --fix",
        "lint:test": "eslint .",
        "format": "prettier --write .",
        "format:test": "prettier --check .",
        "check": "npm run lint:test && npm run format:test && npm run type-check && npm test && npm run build",
        "prepare": "husky"
    },
    "lint-staged": {
        "*.{js,mjs,ts,vue}": [
            "eslint --fix",
            "prettier --write"
        ],
        "*.{css,json,md,yml,yaml}": [
            "prettier --write"
        ],
        "*.php": [
            "vendor/bin/pint"
        ]
    },
    "dependencies": {
        "@inertiajs/vue3": "^3.7.1",
        "@lucide/vue": "^1.47.0",
        "@primeuix/themes": "^3.0.1",
        "primevue": "^5.0.1",
        "tailwindcss-primeui": "^0.6.1",
        "vue": "^3.5.43"
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "@tailwindcss/vite": "^4.3.3",
        "@types/node": "^24.13.5",
        "@vitejs/plugin-vue": "^6.0.9",
        "eslint": "^10.11.0",
        "eslint-config-prettier": "^10.1.8",
        "eslint-plugin-vue": "^10.11.0",
        "globals": "^17.12.0",
        "husky": "^9.1.7",
        "laravel-vite-plugin": "^3.2.0",
        "lint-staged": "^17.5.1",
        "prettier": "^3.9.8",
        "prettier-plugin-tailwindcss": "^0.8.1",
        "tailwindcss": "^4.3.3",
        "typescript": "^7.0.2",
        "typescript-eslint": "^8.70.0",
        "vite": "^8.3.0",
        "vitest": "^5.0.1",
        "vue-eslint-parser": "^10.4.1",
        "vue-tsc": "^3.3.11"
    },
    "optionalDependencies": {
        "@laravel/multiplex": "^0.4.3"
    }
}
