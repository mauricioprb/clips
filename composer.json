{
    "$schema": "https://getcomposer.org/schema.json",
    "name": "mauricioprb/clips",
    "type": "project",
    "description": "Registro de horas e relatório mensal de bolsistas.",
    "keywords": [
        "laravel",
        "inertia",
        "timesheet"
    ],
    "license": "proprietary",
    "require": {
        "php": "^8.5",
        "barryvdh/laravel-dompdf": "^3.1",
        "inertiajs/inertia-laravel": "^3.3",
        "laravel/fortify": "^1.39",
        "laravel/framework": "^13.17",
        "laravel/tinker": "^3.0"
    },
    "require-dev": {
        "fakerphp/faker": "^1.23",
        "laravel/boost": "^2.9",
        "laravel/pail": "^1.2.5",
        "laravel/pao": "^1.0.6",
        "laravel/pint": "^1.27",
        "mockery/mockery": "^1.6",
        "nunomaduro/collision": "^8.6",
        "pestphp/pest": "^5.2",
        "pestphp/pest-plugin-laravel": "^5.0"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "setup": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\"",
            "@php artisan key:generate --ansi",
            "@services",
            "@php artisan migrate --force",
            "npm ci",
            "npm run build"
        ],
        "services": "docker compose up -d --wait --remove-orphans",
        "services:stop": "docker compose down --remove-orphans",
        "dev": [
            "Composer\\Config::disableProcessTimeout",
            "@services",
            "@php artisan migrate --graceful --ansi",
            "@php artisan dev"
        ],
        "lint": "@php vendor/bin/pint",
        "lint:test": "@php vendor/bin/pint --test",
        "test": [
            "@php artisan config:clear --ansi",
            "@php vendor/bin/pest"
        ],
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi"
        ],
        "post-update-cmd": [
            "@php artisan vendor:publish --tag=laravel-assets --ansi --force"
        ],
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "pre-package-uninstall": [
            "Illuminate\\Foundation\\ComposerScripts::prePackageUninstall"
        ]
    },
    "extra": {
        "laravel": {
            "dont-discover": []
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "php-http/discovery": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
