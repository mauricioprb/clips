{
    "type": "library",
    "require": {
        "php": "^8.4",
        "appwrite/appwrite": "28.0.0",
        "dompdf/dompdf": "3.1.6"
    },
    "autoload": {
        "psr-4": {
            "Clips\\": "src/"
        }
    },
    "config": {
        "platform": {
            "php": "8.4.27"
        },
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "require-dev": {
        "laravel/pint": "1.32.1",
        "pestphp/pest": "^5.3"
    },
    "scripts": {
        "lint": "pint --test",
        "format": "pint",
        "test": "pest",
        "test:unit": "pest tests/Unit"
    }
}
